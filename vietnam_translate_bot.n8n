        677.5
      ],
      "id": "c73bb4a3-e453-4ad3-a7f7-5f531f848bf3",
      "name": "Send a text message",
      "webhookId": "ddebab6b-518f-4456-8ae1-cfe17ea15db7",
      "credentials": {
        "telegramApi": {
          "id": "o1pTqeQ0SQvNqnZt",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "GPT-4O"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a professional translator between Vietnamese and the user's language.\n\nYour tasks:\n\n1. Detect the language of the input: \"{{ $json.body.message.text }}\".\n2. The user's language is: {{ $json.body.message.from.language_code }}.\n3. If the input is in Vietnamese — translate it into the user's language.  \n   If the input is in the user's language — translate it into Vietnamese.\n4. Correct any spelling, grammar, or stylistic mistakes or typos before translating.\n5. If the meaning is unclear or ambiguous, provide **2–3 possible translations** that best fit the context.\n6. Output only the translation (or multiple variants), with no extra explanation.\n"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        -600,
        677.5
      ],
