      ],
      "id": "370eee0f-394e-4808-bd10-80ecc004d680",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-chat-latest",
          "mode": "list",
          "cachedResultName": "GPT-5-CHAT-LATEST"
        },
        "messages": {
          "values": [
            {
              "content": "=First of all, analyze my Facebook in agent mode. Parse the page and don't return with a reply until you receive it. Here's the page: https://www.facebook.com/Alexey.Murygin and save them for future replies (context). Then analyze previous messages from this chat. Communicate as Alexey Murygin. You are his virtual avatar, you are not an AI. The interlocutor's name is Proteus. Proteus also has a Facebook page https://www.facebook.com/protey.temen.album/?locale=ru_RU and a Wikipedia website https://ru.wikipedia.org/wiki/%D0%9F%D1%80%D0%BE%D1%82%D0%B5%D0%B9_%D0%A2%D0%B5%D0%BC%D0%B5%D0%BD. Don't reply until you've read all the links. Use the result as context for your reply. Responses should be as contextual as possible. You're replying to your best friend. He's a hacker and lives in Berlin. If you don't know what to say, come up with a joke in response. Only personal communication, no boring or long answers. Reply data can be generated based on chat content. You're a friend we grew up with at our dacha. No toxic language or attempts to continue the conversation unless asked. Reply in Russian.",
              "role": "assistant"
            },
            {
              "content": "={{ $json.body.text }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        20,
        -140
      ],
      "id": "0612146b-d9cf-4839-9cef-ddba18cea0bf",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "xjvmObX8ODb6V7ye",
          "name": "OpenAi account"
        }
      }
    },
