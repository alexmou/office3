      "id": "852c93ed-9338-4e4c-82c7-9856fad621be",
      "name": "If"
    },
    {
      "parameters": {
        "executeOnce": "=",
        "command": "=sudo cat << 'EOF' > {{ $('Get settings').item.json.WorkPath }}run_script.sh\n#!/usr/bin/env bash\npkill -f chrome\npkill -f chromedriver\npkill -f Xvfb\n\nset -eu\n\n# 1) Явно проставляем PATH, иначе n8n может его «обрезать»\nexport PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n\n# 2) Выводим PATH и проверяем наличие xvfb-run и Xvfb\necho \"[DEBUG] PATH=$PATH\"\necho \"[DEBUG] which xvfb-run: $(which xvfb-run || echo 'NOT FOUND')\"\necho \"[DEBUG] which Xvfb:      $(which Xvfb      || echo 'NOT FOUND')\"\necho \"[DEBUG] which python3:   $(which python3   || echo 'NOT FOUND')\"\n\n# 3) Подавляем лишние ошибки D-Bus\nexport DBUS_SESSION_BUS_ADDRESS=/dev/null\n\n# 4) Проверяем, что скрипт реально существует\nscript_path=\"$1\"\nchannel=\"${2:-}\"\nif [ ! -f \"$script_path\" ]; then\n  echo \"[ERROR] Script not found at $script_path\" >&2\n  exit 1\nfi\necho \"[DEBUG] script_path=$script_path\"\necho \"[DEBUG] channel=$channel\"\n\n# 5) Запускаем через полный путь к xvfb-run\n/usr/bin/xvfb-run \\\n  --auto-servernum \\\n  --server-args=\"-screen 0 1920x1080x24 -ac +extension GLX +render\" \\\n  python3 \"$script_path\" \"$channel\" 2>&1 | sed 's/^/[XVFB] /'\n\necho \"[DEBUG] xvfb-run exited with code $?\"\n\n\nEOF\n\nchmod +x {{ $('Get settings').item.json.WorkPath }}run_script.sh\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -440,
        -660
      ],
      "id": "53503caa-4c22-4adb-813a-5d47d962bf7c",
      "name": "make sh"
    },
    {
      "parameters": {
        "command": "=pkill -f chrome\npkill -f chromedriver\npkill -f Xvfb\n\nset -eu\n\n# 1) Явно проставляем PATH, иначе n8n может его «обрезать»\nexport PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n\n# 2) Выводим PATH и проверяем наличие xvfb-run и Xvfb\necho \"[DEBUG] PATH=$PATH\"\necho \"[DEBUG] which xvfb-run: $(which xvfb-run || echo 'NOT FOUND')\"\necho \"[DEBUG] which Xvfb:      $(which Xvfb      || echo 'NOT FOUND')\"\necho \"[DEBUG] which python3:   $(which python3   || echo 'NOT FOUND')\"\n\n# 3) Подавляем лишние ошибки D-Bus\nexport DBUS_SESSION_BUS_ADDRESS=/dev/null\n\n# 5) Запускаем через полный путь к xvfb-run\n/usr/bin/xvfb-run \\\n  --auto-servernum \\\n  --server-args=\"-screen 0 1920x1080x24 -ac +extension GLX +render\" \\\n  python3 {{ $json.WorkPath }}main.py {{ $json.ChannelName }} 2>&1 | sed 's/^/[XVFB] /'\n\necho \"[DEBUG] xvfb-run exited with code $?\"\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        780,
        -680
      ],
      "id": "e39216b9-7440-4f7f-be10-7282d8b42ba2",
      "name": "Execute Command"
    },
    {
      "parameters": {
        "command": "=sudo -u l_murygin /usr/bin/xvfb-run --auto-servernum --server-num=1 --server-args='-screen 0, 1920x1080x24' python3 {{ $json.WorkPath }}main.py {{ $json.ChannelName }}\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        60,
        -700
      ],
      "id": "d3220263-d8c3-4c48-b128-f20d3b6c7d57",
      "name": "Execute Command1"
    },
    {
      "parameters": {
        "command": "sudo systemctl stop xvfb"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -960,
        -100
      ],
      "id": "81223757-1969-49bb-bc23-7105d3cc2b50",
      "name": "Execute Command2"
    },
    {
      "parameters": {
        "executeOnce": "=",
        "command": "=sudo cat << 'EOF' > {{ $('Get settings').item.json.WorkPath }}run_script.sh\n#!/bin/bash\n# Очистка предыдущих процессов\npkill -f \"Xvfb\" || true\npkill -f \"chrome\" || true\nrm -rf /tmp/chrome_*\n\n# Запуск с расширенным логированием\n# Перед запуском Python\nexport XVFB_WHD=\"${XVFB_WHD:-1920x1080x24}\"\nXvfb :99 -screen 0 \"$XVFB_WHD\" -ac +extension RANDR\n\n# Ожидание инициализации\nsleep 2\n\n# Проверка Xvfb\nif ! xdpyinfo -display $DISPLAY >/dev/null 2>&1; then\n  echo \"Xvfb failed to start. Log:\"\n  cat /tmp/xvfb.log\n  exit 1\nfi\n\n# Основной запуск с перенаправлением логов\nsudo -u l_murygin python3 /home/l_murygin/p8/main.py \"$@\" > /tmp/parser.log 2>&1\n\n# Проверка результата\nif [ $? -ne 0 ]; then\n  echo \"Execution failed. Logs:\"\n  echo \"=== Xvfb log ===\"\n  cat /tmp/xvfb.log\n  echo \"=== Parser log ===\"\n  cat /tmp/parser.log\n  echo \"=== ChromeDriver log ===\"\n  cat /tmp/chromedriver.log\nfi\n\n# Очистка\npkill -f \"Xvfb\"\n\nchmod +x {{ $('Get settings').item.json.WorkPath }}run_script.sh\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -700,
        -680
      ],
      "id": "23c14584-946b-4654-9732-1387bf02991b",
      "name": "make sh1"
    },
